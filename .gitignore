# Build artifacts
build/

# Local Zephyr RTOS checkout (from `west update`), but keep our own
# zephyr/module.yml which declares this repo as a Zephyr module for the
# out-of-tree board definition under boards/.
zephyr/*
!zephyr/module.yml

# West workspace (created by `west init`/`west update` when building
# locally, see docs/local-build.md)
.west/
zmk/
modules/
bootloader/
tools/
.build-home/

# IDE/Editor files
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]

# Environment
.env
.env.local

# Logs
*.log

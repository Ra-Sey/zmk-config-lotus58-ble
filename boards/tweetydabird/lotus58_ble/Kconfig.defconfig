# SPDX-License-Identifier: MIT

if BOARD_LOTUS58_BLE_LEFT

config BOARD
    default "lotus58_ble left"

config ZMK_KEYBOARD_NAME
    default "Lotus58 BLE"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif # BOARD_LOTUS58_BLE_LEFT

if BOARD_LOTUS58_BLE_RIGHT

config BOARD
    default "lotus58_ble right"

endif # BOARD_LOTUS58_BLE_RIGHT

if BOARD_LOTUS58_BLE_LEFT || BOARD_LOTUS58_BLE_RIGHT

config ZMK_SPLIT
    default y

config BT_CTLR
    default BT

config PINCTRL
    default y

if USB

config USB_NRFX
    default y

config USB_DEVICE_STACK
    default y

endif # USB

# The nice!view display is populated only on the right half and is added by
# applying the "nice_view" shield in build.yaml, which brings its own
# Kconfig.defconfig (ZMK_DISPLAY, LVGL, SPI) scoped to SHIELD_NICE_VIEW.

endif # BOARD_LOTUS58_BLE_LEFT || BOARD_LOTUS58_BLE_RIGHT
